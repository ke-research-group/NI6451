<Window
    x:Class="Ni6451.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ni6451.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Mica: the Windows 11 base layer for long-lived app windows. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= title bar ================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="USB-6451 Continuous Acquisition" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ================= notifications ================= -->
        <StackPanel Grid.Row="1" Margin="16,0,16,0" Spacing="8">
            <InfoBar
                x:Name="RecoveryBar"
                IsOpen="False"
                Severity="Warning"
                Title="Interrupted acquisition found"
                IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="RecoverButton" Content="Recover now" Click="OnRecover" />
                </InfoBar.ActionButton>
            </InfoBar>

            <InfoBar
                x:Name="AlertBar"
                IsOpen="False"
                Severity="Error"
                IsClosable="True" />
        </StackPanel>

        <!-- ================= body ================= -->
        <Grid Grid.Row="2" Margin="16,12,16,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="392" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ————— left rail: everything you set before pressing Start ————— -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Spacing="12">

                        <!-- device -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE772;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Device" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DeviceCombo" Grid.Column="0" HorizontalAlignment="Stretch" IsEditable="True" PlaceholderText="Dev1" />
                                    <Button x:Name="RefreshButton" Grid.Column="1" Click="OnRefreshDevices" ToolTipService.ToolTip="Rescan for NI-DAQmx devices">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <ComboBox
                                    x:Name="RateCombo"
                                    Header="Sampling rate"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnRateChanged" />

                                <TextBlock x:Name="FixedParamsText" Style="{StaticResource CardCaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- trigger -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="External TTL trigger" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>

                                <ToggleSwitch
                                    x:Name="CaptureTriggerToggle"
                                    Header="Capture trigger"
                                    OnContent="On"
                                    OffContent="Off"
                                    Toggled="OnCaptureTriggerToggled" />

                                <TextBox x:Name="TriggerLineBox" Header="Digital line" HorizontalAlignment="Stretch" />
                                <TextBlock
                                    Text="Sampled on the AI task's own clock, so edges only need to be 1/rate apart."
                                    Style="{StaticResource CardCaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- fault setup -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Fault geometry" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>
                                <TextBlock Text="Used to convert ai0 / ai1 into stress." Style="{StaticResource CardCaptionStyle}" />

                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <RadioButton x:Name="Fault1DRadio" Content="1D" GroupName="FaultType" Checked="OnFaultTypeChanged" />
                                    <RadioButton x:Name="Fault2DRadio" Content="2D" GroupName="FaultType" Checked="OnFaultTypeChanged" Margin="12,0,0,0" />
                                </StackPanel>

                                <ComboBox x:Name="FaultThicknessCombo" Header="Thickness" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>

                        <!-- naming -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Output naming" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SerialBox" Grid.Column="0" Header="Experiment serial" MaxLength="4" TextChanged="OnNamingChanged" />
                                    <NumberBox x:Name="RnBox" Grid.Column="1" Header="Run" SpinButtonPlacementMode="Compact" SmallChange="1" ValueChanged="OnRunNumberChanged" />
                                </Grid>

                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Padding="8,6">
                                    <TextBlock x:Name="FileNamePreviewText" Style="{StaticResource CardCaptionStyle}" FontFamily="Consolas" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock x:Name="NamingHintText" Style="{StaticResource CardCaptionStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- output folder -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Output folder" Style="{StaticResource CardHeaderStyle}" />
                                </StackPanel>

                                <TextBlock x:Name="OutputFolderText" Text="No folder selected" Style="{StaticResource CardCaptionStyle}" />
                                <Button x:Name="ChooseFolderButton" Content="Choose folder…" HorizontalAlignment="Stretch" Click="OnChooseFolder" />
                                <TextBlock x:Name="DiskFreeText" Style="{StaticResource CardCaptionStyle}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Start / Stop stay pinned: they must never be scrolled out of reach mid-run. -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="40" IsEnabled="False" Click="OnStart">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Grid.Column="1" HorizontalAlignment="Stretch" Height="40" IsEnabled="False" Click="OnStop">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ————— right pane: what the experiment is doing right now ————— -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- readout tiles -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="TriggerTile" Grid.Column="0" Style="{StaticResource SubtleCardStyle}" MinWidth="128">
                        <StackPanel Spacing="2">
                            <TextBlock Text="TRIGGER" Style="{StaticResource ReadoutCaptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="TriggerIcon" Glyph="&#xE711;" FontSize="18" VerticalAlignment="Center" />
                                <TextBlock x:Name="TriggerValueText" Text="Waiting" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="NORMAL STRESS · ai0" Style="{StaticResource ReadoutCaptionStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NormalStressText" Text="—" Style="{StaticResource ReadoutValueStyle}" />
                                <TextBlock Text="MPa" Style="{StaticResource ReadoutUnitStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="SHEAR STRESS · ai1" Style="{StaticResource ReadoutCaptionStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ShearStressText" Text="—" Style="{StaticResource ReadoutValueStyle}" />
                                <TextBlock Text="MPa" Style="{StaticResource ReadoutUnitStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource SubtleCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="LVDT · ai2" Style="{StaticResource ReadoutCaptionStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LvdtText" Text="—" Style="{StaticResource ReadoutValueStyle}" />
                                <TextBlock Text="mm" Style="{StaticResource ReadoutUnitStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
                    <controls:LiveTraceView x:Name="TraceView" />
                </Border>
            </Grid>
        </Grid>

        <!-- ================= status bar ================= -->
        <Border
            Grid.Row="3"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Idle" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="SaveProgress" Width="160" Visibility="Collapsed" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Live pipeline telemetry. Hidden while idle so the bar stays quiet. -->
                <StackPanel x:Name="StatsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="16" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Elapsed" Style="{StaticResource StatCaptionStyle}" />
                        <TextBlock x:Name="StatElapsed" Text="0:00" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Written" Style="{StaticResource StatCaptionStyle}" />
                        <TextBlock x:Name="StatWritten" Text="0 MB" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Throughput" Style="{StaticResource StatCaptionStyle}" />
                        <TextBlock x:Name="StatThroughput" Text="0 MB/s" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" ToolTipService.ToolTip="How far the disk writer is behind the acquisition. Sustained high values mean the drive is the bottleneck.">
                        <TextBlock Text="Queue" Style="{StaticResource StatCaptionStyle}" />
                        <ProgressBar x:Name="StatQueueBar" Width="54" Minimum="0" Maximum="1" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatQueue" Text="0%" Style="{StaticResource StatValueStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</Window>
